{
  "name": "jev",
  "private": true,
  "type": "module",
  "description": "Promesómetro: acta de concreción del discurso político, juzgada por Jev (TypeSafe AI)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "example:route": "tsx examples/route-capability.ts",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/dist/server.js",
    "dev:api": "pnpm --filter @jev/api dev",
    "dev:web": "pnpm --filter @jev/web dev",
    "ingest": "tsx apps/api/src/ingest.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
